# Copie para .env.local (ignorado pelo git) e preencha. So valores PUBLICOS entram no front:
# nunca coloque service_role_key nem senha de banco aqui.

# URL da API FastAPI (use HTTPS fora do ambiente local).
VITE_API_URL=http://127.0.0.1:8000
# Projeto Supabase: URL da API e chave publica (anon/publishable).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=preencha_com_a_chave_publica
