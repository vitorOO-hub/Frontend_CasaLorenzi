# Copie para .env.local (ignorado pelo git) e preencha.
# Só valores públicos aqui: a SUPABASE_SERVICE_ROLE_KEY fica apenas no backend (Render).

# "simulado" = dados em memória, sem backend (padrão). "api" = Supabase + FastAPI.
VITE_FONTE_DADOS=simulado

# FastAPI (Render). Sem barra no fim; as rotas ficam em /api/v1.
VITE_API_URL=http://localhost:8000

# Projeto Supabase: Settings > API.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcionais
VITE_SUPABASE_BUCKET_ANEXOS=chamado-anexos
VITE_API_TIMEOUT_MS=15000
